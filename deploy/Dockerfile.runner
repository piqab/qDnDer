# Runner image: qdnder binary + git + buildctl (BuildKit client).
FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG VERSION=0.1.0
RUN CGO_ENABLED=0 go build -ldflags "-s -w -X main.version=${VERSION}" -o /qdnder ./cmd/qdnder

FROM alpine:3.21
RUN apk add --no-cache ca-certificates git openssh-client tzdata
COPY --from=moby/buildkit:v0.21.0 /usr/bin/buildctl /usr/local/bin/buildctl
COPY --from=build /qdnder /usr/local/bin/qdnder
ENV BUILDKIT_HOST=tcp://buildkitd:1234
ENTRYPOINT ["qdnder", "runner"]
